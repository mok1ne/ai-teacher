# --- ИИ (обязательно, ключ только на сервере) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# --- подпись сессионных токенов (любая длинная случайная строка) ---
AUTH_SECRET=change-me-to-a-long-random-string

# --- VK ID (https://id.vk.com / vk.com/apps -> ваше приложение) ---
VK_APP_ID=
VK_SECURE_KEY=
# тот же ID приложения VK — нужен фронту для редиректа на авторизацию:
VITE_VK_APP_ID=

# --- ЮKassa (https://yookassa.ru) ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# (необязательно) переопределить адрес бэкенда ИИ. По умолчанию /api/chat
# VITE_API_URL=/api/chat
